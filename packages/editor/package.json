{
  "name": "kindy-editor",
  "version": "3.0.0",
  "type": "module",
  "description": "Kindy Editor v3 — Canvas-rendered Word-accurate document editor powered by canvas-word architecture.",
  "license": "MIT",
  "module": "./dist-lib/kindy-editor.js",
  "types": "./types/kindy-editor.d.ts",
  "exports": {
    ".": {
      "types": "./types/kindy-editor.d.ts",
      "import": "./dist-lib/kindy-editor.js"
    },
    "./style": {
      "default": "./dist-lib/kindy-editor.css"
    },
    "./builder": {
      "types": "./types/builder.d.ts",
      "import": "./dist-lib/builder.js"
    },
    "./import": {
      "types": "./types/import.d.ts",
      "default": "./dist-lib/import.js"
    },
    "./export": {
      "types": "./types/export.d.ts",
      "default": "./dist-lib/export.js"
    }
  },
  "files": [
    "dist-lib",
    "types"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@chenglou/pretext": "latest",
    "@kindy/shared": "*",
    "@types/fontkit": "^2.0.9",
    "@types/pdfkit": "^0.17.6",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.3",
    "fontkit": "^2.0.4",
    "pdfkit": "^0.19.0",
    "txml": "^6.0.0",
    "vite": "^6.0.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^3.0.0",
    "typescript": "^5.9.2",
    "vue": "^3.5.29"
  }
}
