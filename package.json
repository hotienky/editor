{
  "name": "kindy-editor",
  "version": "2.0.0",
  "description": "DOCX document library SDK and Vue 3 editor with a headless TypeScript core, powered by Tiptap/ProseMirror.",
  "keywords": [
    "docs editor",
    "document editor",
    "editor",
    "office editor",
    "online office",
    "richtext editor",
    "tiptap",
    "tiptap3",
    "vue editor",
    "vue3 editor",
    "web editor",
    "web office",
    "word editor",
    "wysiwyg editor"
  ],
  "homepage": "https://github.com/hotienky/editor",
  "bugs": {
    "url": "https://github.com/hotienky/editor/issues",
    "email": "kyit1506@gmail.com"
  },
  "license": "MIT",
  "author": {
    "name": "Kindy",
    "email": "kyit1506@gmail.com",
    "url": "https://github.com/hotienky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hotienky/editor.git"
  },
  "files": [
    "dist",
    "docs/README.md",
    "docs/getting-started.md",
    "docs/ui-engine.md",
    "docs/api-reference.md",
    "docs/performance.md",
    "docs/plugin-development.md",
    "docs/completion-roadmap.md",
    "openapi",
    "CHANGELOG.md",
    "GUIDE.md",
    "CAPABILITIES.md",
    "MIGRATION.md"
  ],
  "main": "./dist/kindy-editor.cjs",
  "module": "./dist/kindy-editor.js",
  "types": "./dist/kindy-editor.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/kindy-editor.d.ts",
      "import": "./dist/kindy-editor.js",
      "require": "./dist/kindy-editor.cjs"
    },
    "./style": {
      "default": "./dist/kindy-editor.css"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/kindy-core.js",
      "require": "./dist/kindy-core.cjs"
    },
    "./openapi": {
      "default": "./openapi/document-api.yaml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "vite build --config vite.demo.config.js",
    "dev": "vite --port 9000 --open --force",
    "preview": "vite preview",
    "preview:demo": "vite preview --config vite.demo.config.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:package": "node scripts/test-packed-consumer.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark:long-doc": "node scripts/benchmark-long-document.mjs",
    "benchmark:ci": "node scripts/benchmark-long-document.mjs --assert --output=.artifacts/long-document.json",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write .",
    "lint": "oxlint --fix src",
    "lint:check": "oxlint src",
    "test:libreoffice": "KINDY_TEST_LIBREOFFICE=1 vitest run src/codecs/__tests__/libreoffice.test.js",
    "analyzer": "vite-bundle-visualizer",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@eslint/object-schema": "3.0.2",
    "@floating-ui/dom": "1.7.5",
    "@tiptap/core": "3.20.0",
    "@tiptap/extension-bold": "3.20.0",
    "@tiptap/extension-bubble-menu": "3.20.0",
    "@tiptap/extension-code-block": "3.20.0",
    "@tiptap/extension-code-block-lowlight": "3.20.0",
    "@tiptap/extension-collaboration": "3.20.0",
    "@tiptap/extension-details": "3.20.0",
    "@tiptap/extension-document": "3.20.0",
    "@tiptap/extension-drag-handle": "3.16.0",
    "@tiptap/extension-drag-handle-vue-3": "3.16.0",
    "@tiptap/extension-floating-menu": "3.20.0",
    "@tiptap/extension-horizontal-rule": "3.20.0",
    "@tiptap/extension-image": "3.20.0",
    "@tiptap/extension-invisible-characters": "3.20.0",
    "@tiptap/extension-link": "3.20.0",
    "@tiptap/extension-list": "3.20.0",
    "@tiptap/extension-mathematics": "3.20.0",
    "@tiptap/extension-mention": "3.20.0",
    "@tiptap/extension-node-range": "3.20.0",
    "@tiptap/extension-subscript": "3.20.0",
    "@tiptap/extension-superscript": "3.20.0",
    "@tiptap/extension-table": "3.20.0",
    "@tiptap/extension-table-of-contents": "3.20.0",
    "@tiptap/extension-text-align": "3.20.0",
    "@tiptap/extension-text-style": "3.20.0",
    "@tiptap/extension-typography": "3.20.0",
    "@tiptap/extension-unique-id": "3.20.0",
    "@tiptap/extensions": "3.20.0",
    "@tiptap/pm": "3.20.0",
    "@tiptap/starter-kit": "3.20.0",
    "@tiptap/suggestion": "3.20.0",
    "@tiptap/vue-3": "3.20.0",
    "@tiptap/y-tiptap": "3.0.2",
    "@tool-belt/type-predicates": "1.4.1",
    "@vueuse/core": "14.2.1",
    "cropperjs": "^2.1.1",
    "docx": "^9.7.1",
    "dom-to-image-more": "3.7.2",
    "es-drager": "1.2.11",
    "fflate": "^0.8.3",
    "file-saver": "2.0.5",
    "hotkeys-js": "4.0.2",
    "jsbarcode": "3.12.3",
    "katex": "0.16.33",
    "lowlight": "3.3.0",
    "mammoth": "^1.12.0",
    "nzh": "1.0.14",
    "pretty-bytes": "7.1.0",
    "pure-svg-code": "1.0.6",
    "smooth-signature": "1.0.15",
    "vue-i18n": "11.2.8",
    "y-prosemirror": "1.2.15",
    "y-protocols": "1.0.6",
    "yjs": "13.6.29"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue-macros/reactivity-transform": "^3.1.2",
    "@vue/test-utils": "^2.4.11",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "less": "^4.5.1",
    "less-loader": "^12.3.1",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.1",
    "tdesign-vue-next": "1.18.2",
    "typescript": "^5.9.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue": "^7.1.1",
    "unplugin-vue-components": "^31.0.0",
    "unplugin-vue-macros": "^2.14.5",
    "vite": "^7.3.1",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.29"
  },
  "overrides": {
    "rolldown": "^1.1.3",
    "uuid": "^11.1.1",
    "postcss": {
      "nanoid": "^3.3.18"
    }
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "lint-staged": {
    "*.{js,vue,less}": [
      "oxfmt --write src",
      "oxlint --fix src"
    ]
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
