{
  "name": "kindy-editor-monorepo",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/editor",
    "examples/*"
  ],
  "scripts": {
    "postinstall": "patch-package --patch-dir pretext-patch",
    "dev": "npm run dev --workspace kindy-editor",
    "demo": "npm run dev --workspace demo-app",
    "build": "npm run build --workspace kindy-editor",
    "typecheck": "npm run typecheck --workspace kindy-editor",
    "test": "npm run test --workspace kindy-editor",
    "docs:dev": "vitepress dev packages/editor/docs --port 9001 --open",
    "docs:build": "vitepress build packages/editor/docs",
    "docs:preview": "vitepress preview packages/editor/docs"
  },
  "devDependencies": {
    "@mcp-b/global": "^5.0.1",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.2",
    "vitepress": "^1.6.4"
  }
}